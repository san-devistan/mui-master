CONVEX_DEPLOYMENT=dev:<deployment>
CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_SITE_URL=https://<deployment>.convex.site

# Required Convex env var for the song import (https://audiometa.io/dashboard/api).
# pnpm exec convex env set AUDIOMETA_API_KEY <api-key>
# Start or refresh the 1B+ Spotify streams song catalog (also runs daily):
# pnpm exec convex run catalog:startImport
