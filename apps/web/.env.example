VITE_CONVEX_URL=https://<deployment>.convex.cloud
# Better Auth requests go through /api/auth to this (the deployment URL ending in .convex.site).
VITE_CONVEX_SITE_URL=https://<deployment>.convex.site

VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>

# Cloudflare Turnstile's public site key. Its secret goes in the Worker secret TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=<turnstile_site_key>
